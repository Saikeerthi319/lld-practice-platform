{
  "name": "lld-practice-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@lld/api",
    "dev:web": "npm run dev --workspace=@lld/web",
    "build": "npm run build --workspace=@lld/web && npm run build --workspace=@lld/api",
    "start": "npm run start --workspace=@lld/api",
    "test": "npm run test --workspace=@lld/api",
    "db:generate": "npm run db:generate --workspace=@lld/api",
    "db:migrate": "npm run db:migrate --workspace=@lld/api",
    "db:seed": "npm run db:seed --workspace=@lld/api",
    "db:setup": "npm run db:setup --workspace=@lld/api",
    "docs:pdf": "node scripts/md-to-pdf.mjs"
  },
  "devDependencies": {
    "pdfkit": "^0.20.2"
  }
}
