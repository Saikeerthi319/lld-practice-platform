# Copy to apps/api/.env (or project root if your tooling loads it there)
PORT=4000
DATABASE_URL="file:./dev.db"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Prefer openai when key is set; use "heuristic" to force the fallback evaluator
EVALUATOR=auto
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
